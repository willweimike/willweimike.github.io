---
import { profileData } from '../data/profile';
---

<section id="skills" class="section">
  <div class="section-header">
    <h2 class="section-title">
      <span class="section-index">03</span>
      Technical Skills & Certifications
    </h2>
    <span class="mono section-sub">Core Competencies</span>
  </div>

  <div class="skills-grid">
    {profileData.skillCategories.map((cat) => (
      <div class="card skill-card">
        <h3 class="skill-title">{cat.title}</h3>
        <p class="skill-desc">{cat.description}</p>
        <div class="tag-row">
          {cat.skills.map((skill) => <span class="tag">{skill}</span>)}
        </div>
      </div>
    ))}
  </div>

  <div class="certs-block">
    <h3 class="mono group-label">LICENSES & VERIFIED CERTIFICATIONS</h3>
    <div class="certs-grid">
      {profileData.certifications.map((cert) => (
        <div class="card cert-card">
          <div>
            <h4 class="cert-name">{cert.name}</h4>
            <p class="mono cert-meta">{cert.issuer} · Issued {cert.issued}</p>
          </div>
          {cert.credentialUrl && (
            <a
              href={cert.credentialUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="pr-pill"
            >
              Verify on Credly ↗
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-sub {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .skill-card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .skill-title {
    font-size: 1.02rem;
    font-weight: 600;
  }

  .skill-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    margin-bottom: 0.25rem;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .certs-block {
    margin-top: 2rem;
  }

  .group-label {
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .certs-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cert-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 1rem 1.35rem;
  }

  .cert-name {
    font-size: 0.96rem;
    font-weight: 600;
  }

  .cert-meta {
    font-size: 0.78rem;
    color: var(--text-secondary);
    margin-top: 0.15rem;
  }
</style>
